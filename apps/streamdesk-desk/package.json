{
  "name": "@tv-remote/streamdesk-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StreamDesk macOS desk agent — open, quit, and switch apps from the phone",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
