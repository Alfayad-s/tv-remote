    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tv-remote/streamdesk-protocol": "*",
    "bonjour-service": "^1.4.4",
    "ws": "^8.18.3",
    "tsx": "^4.20.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
