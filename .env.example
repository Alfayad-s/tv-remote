# Local Node.js service
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=debug
TV_ADAPTER=mock
DISCOVERY_MODE=auto
DISCOVERY_TIMEOUT_MS=3000
PAIRING_TIMEOUT_MS=90000
PAIRING_CLIENT_NAME=iFFALCON Remote
CREDENTIALS_DIR=./data/credentials

# Optional. Comma-separated origins allowed to connect over WebSocket.
# Leave empty to allow any origin on the local network during development.
WS_ALLOWED_ORIGINS=

# Frontend — leave empty to use the page hostname (recommended for phone testing).
# Example: ws://192.168.1.20:8787
VITE_WS_URL=
VITE_WS_PORT=8787
