# Local Node.js service
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=debug
TV_ADAPTER=mock
DISCOVERY_MODE=auto
# Production (NODE_ENV=production) defaults to mdns and hides 127.0.0.1.
# Set INCLUDE_MOCK=true only when you want the demo TV in a production process.
INCLUDE_MOCK=
DISCOVERY_TIMEOUT_MS=3000
PAIRING_TIMEOUT_MS=90000
PAIRING_CLIENT_NAME=iFFALCON Remote
CREDENTIALS_DIR=./data/credentials

# Optional. Comma-separated origins allowed to connect over WebSocket.
# Leave empty to allow any origin on the local network during development.
WS_ALLOWED_ORIGINS=

# Folder of the built PWA served next to the WebSocket. Leave empty to auto-detect
# apps/web/dist. Set false to serve only /health and WebSocket.
WEB_DIST=

# Frontend — leave empty on the home computer so a tunnel or LAN page uses /ws
# on the same host. Set this only if the PWA is hosted separately (Vercel) and
# must point at a home tunnel: wss://remote.yourdomain.com/ws
VITE_WS_URL=
VITE_WS_PORT=8787
